{% extends 'admin/base.html.twig' %}

{% block title %}Admin Dashboard | Gonzaga's Apparel{% endblock %}

{% block body %}
<main class="admin-shell">
    <div class="section-kicker">MANAGEMENT <span></span></div>
    <h1>ADMIN DASHBOARD</h1>

    <div class="stats">
        <div>
            <strong>{{ stats.userCount }}</strong>
            <span>CUSTOMERS</span>
        </div>
        <div>
            <strong>{{ stats.orderCount }}</strong>
            <span>ORDERS</span>
        </div>
        <div>
            <strong>{{ stats.revenue|money }}</strong>
            <span>TOTAL REVENUE</span>
        </div>
        <div>
            <strong>0</strong>
            <span>PRODUCTS</span>
        </div>
    </div>

    <div class="admin-actions" style="display: flex; gap: 10px; margin-bottom: 2rem; flex-wrap: wrap;">
        <a class="button button--filled" href="{{ path('app_admin_product_new') }}">+ ADD NEW PRODUCT</a>
        <a class="button button--outline" href="{{ path('app_admin_category_new') }}">+ ADD CATEGORY</a>
        <a class="button button--outline" href="{{ path('app_admin_orders') }}">VIEW ALL ORDERS ({{ stats.orderCount }})</a>
    </div>

    <section class="admin-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2>INVENTORY &amp; PRODUCTS</h2>
            <a href="{{ path('app_admin_product_new') }}" class="button button--filled" style="padding: 6px 14px; font-size: 11px;">+ NEW PRODUCT</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>IMAGE</th>
                        <th>PRODUCT NAME</th>
                        <th>CATEGORY</th>
                        <th>PRICE</th>
                        <th>STOCK</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="7" style="text-align: center;">No products in inventory yet.</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin-card" style="margin-top: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h2>RECENT ORDERS</h2>
            <a href="{{ path('app_admin_orders') }}" class="table-link">View All Orders →</a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ORDER</th>
                        <th>CUSTOMER</th>
                        <th>METHOD</th>
                        <th>STATUS</th>
                        <th>TOTAL</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in recentOrders %}
                        <tr>
                            <td><strong>#{{ order.id }}</strong></td>
                            <td>{{ order.shipping_name|default(order.account_name) }}<br><small style="color: #666;">{{ order.email }}</small></td>
                            <td>{{ order.payment_method|upper }}</td>
                            <td>
                                <span class="badge badge--{{ order.status }}">
                                    {{ order.status|upper }}
                                </span>
                            </td>
                            <td><strong>{{ order.total_amount|money }}</strong></td>
                            <td>
                                <a class="table-link" href="{{ path('app_admin_order', { id: order.id }) }}">Manage</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" style="text-align: center;">No orders placed yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</main>
{% endblock %}
