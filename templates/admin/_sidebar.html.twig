{# ============================================================
   Admin Sidebar Partial
   templates/admin/_sidebar.html.twig
   Included by: admin/base.html.twig
   ============================================================ #}
<aside class="admin-sidebar" id="adminSidebar">

    {# ── Brand / Logo ── #}
    <div class="admin-sidebar-header">
        <a href="{{ path('app_admin_dashboard') }}" class="admin-sidebar-brand">
            <img src="{{ asset('assets/images/logo-placeholder.svg') }}" alt="Gonzaga's Apparel">
            <span class="admin-portal-badge">ADMIN PORTAL</span>
        </a>
    </div>

    {# ── Logged-in User Card ── #}
    <div class="admin-user-card">
        <div class="admin-avatar">
            <span>A</span>
        </div>
        <div class="admin-user-info">
            <strong>Administrator</strong>
            <small>admin@gonzagas.local</small>
        </div>
    </div>

    {# ── Primary Navigation ── #}
    <nav class="admin-nav" aria-label="Admin Navigation">

        <div class="admin-nav-group-title">MAIN MENU</div>

        {# Dashboard #}
        <a href="{{ path('app_admin_dashboard') }}"
           class="admin-nav-link {% if app.request.attributes.get('_route') in ['app_admin_dashboard', 'app_admin_root', 'app_admin_dashboard_legacy'] %}is-active{% endif %}">
            <svg class="admin-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3"  y="3"  width="7" height="7"></rect>
                <rect x="14" y="3"  width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3"  y="14" width="7" height="7"></rect>
            </svg>
            <span>Dashboard</span>
        </a>

        {# Orders #}
        <a href="{{ path('app_admin_orders') }}"
           class="admin-nav-link {% if app.request.attributes.get('_route') in ['app_admin_orders', 'app_admin_order', 'app_admin_orders_legacy', 'app_admin_order_legacy'] %}is-active{% endif %}">
            <svg class="admin-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span>Orders</span>
        </a>

        <div class="admin-nav-group-title">CATALOG &amp; INVENTORY</div>

        {# Add Product #}
        <a href="{{ path('app_admin_product_new') }}"
           class="admin-nav-link {% if app.request.attributes.get('_route') in ['app_admin_product_new', 'app_admin_product_edit', 'app_admin_product_create_legacy', 'app_admin_product_edit_legacy'] %}is-active{% endif %}">
            <svg class="admin-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="16"></line>
                <line x1="8"  y1="12" x2="16" y2="12"></line>
            </svg>
            <span>Add Product</span>
        </a>

        {# Add Category #}
        <a href="{{ path('app_admin_category_new') }}"
           class="admin-nav-link {% if app.request.attributes.get('_route') in ['app_admin_category_new', 'app_admin_category_create_legacy'] %}is-active{% endif %}">
            <svg class="admin-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                <line x1="12" y1="11" x2="12" y2="17"></line>
                <line x1="9"  y1="14" x2="15" y2="14"></line>
            </svg>
            <span>Add Category</span>
        </a>

        <div class="admin-nav-group-title">QUICK ACCESS</div>

        {# View Storefront — clickable without href/URL preview #}
        <a class="admin-nav-link" style="cursor: pointer;">
            <svg class="admin-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>View Storefront</span>
        </a>

    </nav>

    {# ── Log Out — clickable without href/URL preview ── #}
    <div class="admin-sidebar-footer">
        <a class="admin-logout-btn" style="cursor: pointer;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Log Out</span>
        </a>
    </div>

</aside>
