{% extends 'base.html.twig' %}

{% block title %}Privacy Policy | Gonzaga's Apparel{% endblock %}
{% block body_class %}shop-page{% endblock %}

{% block body %}
<main class="shop-shell narrow">
    <div class="section-kicker">CUSTOMER CARE <span></span></div>
    <h1>PRIVACY POLICY</h1>

    <div class="care-page">
        <h2>Your Privacy Matters</h2>
        <p>Gonzaga's Apparel respects your privacy and is committed to protecting your personal information. This Privacy Policy explains how we collect, use, and safeguard your data when you visit our website or make a purchase.</p>

        <h2>Information We Collect</h2>
        <ul>
            <li>Contact details such as your name, email address, phone number, and delivery address.</li>
            <li>Order history and transaction payment details (payment reference numbers and receipts).</li>
            <li>Account credentials and session preferences.</li>
        </ul>

        <h2>How We Use Your Data</h2>
        <p>We use your information strictly to fulfill and deliver orders, process payments, provide customer support, and keep you updated on your order status.</p>
    </div>
</main>
{% endblock %}
