{% extends 'base.html.twig' %}

{% block title %}Size Guide | Gonzaga's Apparel{% endblock %}
{% block body_class %}shop-page{% endblock %}

{% block body %}
<main class="shop-shell narrow">
    <div class="section-kicker">CUSTOMER CARE <span></span></div>
    <h1>SIZE GUIDE</h1>

    <div class="care-page">
        <h2>T-Shirts (Unisex Regular Fit)</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>SIZE</th>
                        <th>CHEST (INCHES)</th>
                        <th>LENGTH (INCHES)</th>
                        <th>SHOULDER (INCHES)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>S</td><td>38"</td><td>27"</td><td>17"</td></tr>
                    <tr><td>M</td><td>40"</td><td>28"</td><td>18"</td></tr>
                    <tr><td>L</td><td>42"</td><td>29"</td><td>19"</td></tr>
                    <tr><td>XL</td><td>44"</td><td>30"</td><td>20"</td></tr>
                    <tr><td>2XL</td><td>46"</td><td>31"</td><td>21"</td></tr>
                </tbody>
            </table>
        </div>

        <h2 style="margin-top: 2rem;">Hoodies (Relaxed Oversized Fit)</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>SIZE</th>
                        <th>CHEST (INCHES)</th>
                        <th>LENGTH (INCHES)</th>
                        <th>SLEEVE (INCHES)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>S / M</td><td>44"</td><td>28"</td><td>24"</td></tr>
                    <tr><td>L / XL</td><td>48"</td><td>30"</td><td>25"</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</main>
{% endblock %}
