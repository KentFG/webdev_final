{% extends 'base.html.twig' %}

{% block title %}Shipping &amp; Returns | Gonzaga's Apparel{% endblock %}
{% block body_class %}shop-page{% endblock %}

{% block body %}
<main class="shop-shell narrow">
    <div class="section-kicker">CUSTOMER CARE <span></span></div>
    <h1>SHIPPING &amp; RETURNS</h1>

    <div class="care-page">
        <h2>Shipping Information</h2>
        <p>We ship nationwide across the Philippines. All orders are processed within 1–2 business days.</p>

        <h2>Delivery Times</h2>
        <ul>
            <li><strong>Metro Manila:</strong> 2–4 business days</li>
            <li><strong>Provincial (Luzon):</strong> 4–6 business days</li>
            <li><strong>Visayas &amp; Mindanao:</strong> 5–8 business days</li>
        </ul>

        <h2>Shipping Rates</h2>
        <p>Standard nationwide shipping is flat rate <strong>₱150.00</strong>. Enjoy <strong>FREE SHIPPING</strong> on all orders of ₱2,500.00 or more.</p>

        <h2>Returns &amp; Exchanges</h2>
        <p>Items may be returned or exchanged within 7 days of delivery, provided they are unwashed, unworn, and have all original tags attached.</p>
    </div>
</main>
{% endblock %}
