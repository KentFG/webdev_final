{% extends 'base.html.twig' %}

{% block title %}Terms &amp; Conditions | Gonzaga's Apparel{% endblock %}
{% block body_class %}shop-page{% endblock %}

{% block body %}
<main class="shop-shell narrow">
    <div class="section-kicker">CUSTOMER CARE <span></span></div>
    <h1>TERMS &amp; CONDITIONS</h1>

    <div class="care-page">
        <h2>General Terms</h2>
        <p>By browsing or purchasing from Gonzaga's Apparel, you agree to comply with and be bound by the following terms and conditions.</p>

        <h2>Product Availability &amp; Pricing</h2>
        <p>All prices are listed in Philippine Pesos (PHP). We reserve the right to update product pricing and availability at any time without prior notice.</p>

        <h2>Orders &amp; Payment</h2>
        <p>Orders paid via GCash must include a valid transaction receipt before being processed and dispatched. For COD orders, please ensure the recipient is available to receive and pay for the parcel upon delivery.</p>

        <h2>Intellectual Property</h2>
        <p>All logos, imagery, and product designs on this site are the property of Gonzaga's Apparel.</p>
    </div>
</main>
{% endblock %}
